{
  "name": "tasks",
  "version": "1.0.0",
  "description": "Tasks App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vue": "^3.4.21",
    "vue-chartjs": "^5.3.3",
    "vue-draggable-next": "^2.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kanban.tasks",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "api/**/*",
      "package.json"
    ]
  }
}
